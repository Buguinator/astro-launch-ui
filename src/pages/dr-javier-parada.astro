---
import "aos/dist/aos.css";

import Layout from '../layouts/Layout.astro';
import HeaderAbout from "../components/dr/header"
import FeaturesAbout from "../components/dr/features"
import TestimonialAbout from "../components/dr/testimonials"
import FooterFreePresentation from "../components/presentation/footerFree"
import ServiceAbout from "../components/dr/service"
import ServiceRight from "../components/dr/serviceright"
import Feed from "../components/presentation/feed"
import Certificados from "../components/dr/certificados"
import { servicioCorporal, servicioFacial, servicioMamas, servicioHombres } from "../components/dr/const/services.js";

import imgCorporal1 from "../assets/dr-corporal/1.webp";
import imgCorporal2 from "../assets/dr-corporal/2.webp";
import imgCorporal3 from "../assets/dr-corporal/3.webp";

import imgFacial1 from "../assets/dr-facial/1.webp";
import imgFacial2 from "../assets/dr-facial/2.webp";
import imgFacial3 from "../assets/dr-facial/3.webp";
import imgFacial4 from "../assets/dr-facial/4.webp";
import imgFacial5 from "../assets/dr-facial/5.webp";
import imgFacial6 from "../assets/dr-facial/6.webp";

import imgMamas1 from "../assets/dr-mm/1.webp";
import imgMamas2 from "../assets/dr-mm/2.webp";
import imgMamas3 from "../assets/dr-mm/3.webp";
import imgMamas4 from "../assets/dr-mm/4.webp";

import imgHombres1 from "../assets/dr-hombres/1.webp";
import imgHombres2 from "../assets/dr-hombres/2.webp";
import imgHombres3 from "../assets/dr-hombres/3.webp";
import imgHombres4 from "../assets/dr-hombres/4.webp";

---

<Layout title="Dr. Javier Parada">
	<main>
    <HeaderAbout client:only="react" />
    <!-- About -->
    <TestimonialAbout client:only="react" />
    <!-- Certificados -->
    <Certificados client:only="react" />
    <!-- Servicios -->
    <FeaturesAbout client:only="react" />
    <ServiceAbout client:only="react" service={servicioCorporal} images={[imgCorporal1, imgCorporal2, imgCorporal3]}  />
    <ServiceRight client:only="react" service={servicioFacial} images={[imgFacial1, imgFacial2, imgFacial3, imgFacial4, imgFacial5, imgFacial6]} />
    <ServiceAbout client:only="react" service={servicioMamas} images={[imgMamas1, imgMamas2, imgMamas3, imgMamas4]} />
    <ServiceRight client:only="react" service={servicioHombres} images={[imgHombres1, imgHombres2, imgHombres3, imgHombres4]} />
    
    <div class="h-[100px]"></div>
    <!-- Google e Instagram -->
    <Feed client:only="react" id="elfsight-app-ae53c565-e63c-4093-ae1c-a3c613f0233c" />
    <Feed client:only="react" id="elfsight-app-326a9796-1103-49e5-8d21-c7da551a279b" />
    <div class="h-[50px]"></div>
    <FooterFreePresentation client:only="react" />
  </main>
</Layout>