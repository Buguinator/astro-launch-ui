---
export async function getStaticPaths() {
  return [
    { params: { locale: undefined } },
    { params: { locale: 'en' } }
  ];
}

import "aos/dist/aos.css";

import Layout from '../../layouts/Layout.astro';
import HeaderPresentation from "../../components/presentation/header"
import LogosPresentation from "../../components/presentation/logos"
import PalettePresentationFree from "../../components/presentation/palette"
import CodePresentation from "../../components/presentation/code"
import FreeToProPresentation from "../../components/presentation/freeToPro"
import AstroPresentation from "../../components/presentation/astro"
import GithubPresentation from "../../components/presentation/github"
import PricingPresentation from "../../components/presentation/pricing"
import FooterFreePresentation from "../../components/presentation/footerFree"
import Feed from "../../components/presentation/feed"
import ServiceAbout from "../../components/presentation/service"
import ServiceRight from "../../components/presentation/serviceright"

import { servicioAparato } from "../../components/dr/const/services.js";
import { servicioTratamientos } from "../../components/dra/const/services.js";

---

<Layout title="Presentation Page">
	<main>
    <!-- Hero -->
    <HeaderPresentation client:only="react" />
    <!-- Porcedimientos faciales -->
    <FreeToProPresentation client:only="react" />
    <!-- Procedimientos corporales -->
    <PalettePresentationFree client:only="react" />
    <!-- Aparatologia -->
    <div class="h-[150px]"></div>
    <ServiceAbout client:only="react" service={servicioAparato} />
    <div class="h-[100px]"></div>
    <!-- Tratamientos -->
    <ServiceRight client:only="react" service={servicioTratamientos}/>
    <!-- Tratamientos lasér -->
    <CodePresentation client:only="react" />
    <!-- Lasér Diodo -->
    <AstroPresentation client:only="react" />
    <!-- Especialistas -->
    <PricingPresentation client:only="react" />
    <!-- Logotipos carousel -->
    <LogosPresentation client:only="react" />
    <!-- Google e Instagram -->
    <Feed client:only="react" id="elfsight-app-004455a3-ae7a-4b8f-b476-71b32fc12a2f" />
    <Feed client:only="react" id="elfsight-app-78cf6388-c0a2-4f7d-bb98-e7bdff88849d" />

    <!-- Horarios y mapa -->
    <GithubPresentation client:only="react" />
    <!-- Footer -->
    <FooterFreePresentation client:only="react" />
  </main>
</Layout>